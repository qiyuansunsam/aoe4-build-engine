{"post_stream":{"posts":[{"id":744221,"username":"StovetopHail455","avatar_template":"/user_avatar/forums.ageofempires.com/stovetophail455/{size}/29387_2.png","created_at":"2022-05-31T12:04:42.666Z","cooked":"\u003cp\u003eOne problem with China is that when they are looking for the wheelbarrow (like all civs), they have to take an unfavorable debuff on taxes.\u003c/p\u003e\n\u003cp\u003eLet’s look at an example:\u003c/p\u003e\n\u003cp\u003eWithout wheelbarrow :\u003c/p\u003e\n\u003cp\u003eTo collect 30 food =\u0026gt; with a carry capacity of 10, you have to do 3 trips and so collect 3 gold as taxes.\u003c/p\u003e\n\u003cp\u003eWith wheelbarrow :\u003cbr\u003e\nTo collect 30 food =\u0026gt; the carry capacity is now 15, so they do only two trips, so they collect now only 2 gold.\u003c/p\u003e\n\u003cp\u003eSo wheelbarrow for chinese is : Increases income by +7-8%, and reduces taxes by -33%.\u003cbr\u003e\nWhile every civ grab this upgrade by default, with China you really need to think about it.\u003c/p\u003e\n\u003cp\u003eIt’s not really normal to pay for an upgrade, that actually makes your economy worst.\u003c/p\u003e\n\u003cp\u003eSolution :\u003cbr\u003e\nA simple solution, is when wheelbarrow is researched, to increase taxes generated when a villager does a drop off from 1 to 1.5. This way, the taxes generated will remain the same.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T12:04:42.666Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":660,"reads":72,"readers_count":71,"score":3379.4,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":4}],"moderator":false,"admin":false,"staff":false,"user_id":108960,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/1","reactions":[{"id":"heart","type":"emoji","count":4}],"current_user_reaction":null,"reaction_users_count":4,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false,"can_translate":false},{"id":744308,"username":"Calerb","avatar_template":"/user_avatar/forums.ageofempires.com/calerb/{size}/119454_2.png","created_at":"2022-05-31T13:16:28.036Z","cooked":"\u003cp\u003eI fail to see how its a nerf. They move faster, and the same 3 trips they’d make for 30 food is not only faster because of the movement buff, but provides 45 food instead.\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T13:16:28.036Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":2,"reads":70,"readers_count":69,"score":59.0,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":"Age_Insider","flair_name":"Age_Insider","flair_url":"//cdn.ageofempires.com/aoe-forums/original/3X/5/7/57ac945b03e64b35defdd85916e382852840f723.png","flair_bg_color":"","flair_color":"","flair_group_id":56,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Age Insider","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":107195,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/2","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744324,"username":"Volo1989","avatar_template":"/user_avatar/forums.ageofempires.com/volo1989/{size}/108765_2.png","created_at":"2022-05-31T13:25:51.876Z","cooked":"\u003cp\u003eMaybe tax should be calculated based on amount of resorces dropped in mill or lumber camps,that would buff it nicely.\u003c/p\u003e","post_number":3,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T13:25:51.876Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":2,"reads":67,"readers_count":66,"score":38.4,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":"Age_Insider","flair_name":"Age_Insider","flair_url":"//cdn.ageofempires.com/aoe-forums/original/3X/5/7/57ac945b03e64b35defdd85916e382852840f723.png","flair_bg_color":"","flair_color":"","flair_group_id":56,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Age Insider","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":109009,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/3","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744325,"username":"ZdsAlpha","avatar_template":"/user_avatar/forums.ageofempires.com/zdsalpha/{size}/29569_2.png","created_at":"2022-05-31T13:26:03.038Z","cooked":"\u003caside class=\"quote no-group\" data-username=\"StovetopHail455\" data-post=\"1\" data-topic=\"205270\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.ageofempires.com/user_avatar/forums.ageofempires.com/stovetophail455/48/29387_2.png\" class=\"avatar\"\u003e StovetopHail455:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eA simple solution, is when wheelbarrow is researched, to increase taxes generated when a villager does a drop off from 1 to 1.5. This way, the taxes generated will remain the same.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eNo. Recent buffs have already increased tax a lot. You wont get sub 4 min wheelbarrow age up timing so easily. China is the only civ that can age up so fast.\u003c/p\u003e\n\u003caside class=\"quote no-group\" data-username=\"StovetopHail455\" data-post=\"1\" data-topic=\"205270\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.ageofempires.com/user_avatar/forums.ageofempires.com/stovetophail455/48/29387_2.png\" class=\"avatar\"\u003e StovetopHail455:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eIncreases income by +7-8%, and reduces taxes by -33%.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003e33% of 20 is 6.6 and 7% of 200 is 14.  So you are getting ~14 food instead of 6.6 gold.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T13:26:03.038Z","reply_count":0,"reply_to_post_number":null,"quote_count":1,"incoming_link_count":4,"reads":64,"readers_count":63,"score":32.8,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":106322,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744345,"username":"StovetopHail455","avatar_template":"/user_avatar/forums.ageofempires.com/stovetophail455/{size}/29387_2.png","created_at":"2022-05-31T13:57:41.292Z","cooked":"\u003cp\u003eImagine you are one tile away from drop off =\u0026gt;\u003c/p\u003e\n\u003cp\u003enormal speed 1.13 tile/s, so you need 1/1.13x2 to go to drop and return gathering = 1.77s.\u003cbr\u003e\nWith wheelbarrow, we need 1/(1.13x1.15)x2=1.54s. So you have only won 0.23s per trip.\u003c/p\u003e\n\u003cp\u003eIn 3 trips you win 2.23 s (0.23x2s +1.77s for trip you don’t have to do), but lost 1 gold. In 2.23s, the standard gather rate is 0.75, so it means 1.67 ressources.\u003c/p\u003e\n\u003cp\u003eAs you have 1 less gold, but gain 1.67 more, you end up with +0.67 ressources after wheelbarrow… while a normal civ would have won +1.67 in 3 trips per villager when they research wheelbarrow.\u003c/p\u003e\n\u003cp\u003eSo depending on the situation, it’s better to have 1 more gold than 1.67 food, and the upgrade is way less cost effective than for any civ.\u003c/p\u003e\n\u003cp\u003eI’m just asking that wheelbarrow does the same for every civ.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T13:58:47.672Z","reply_count":2,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":1,"reads":60,"readers_count":59,"score":57.0,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":107195,"username":"Calerb","avatar_template":"/user_avatar/forums.ageofempires.com/calerb/{size}/119454_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":108960,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/5","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744348,"username":"Calerb","avatar_template":"/user_avatar/forums.ageofempires.com/calerb/{size}/119454_2.png","created_at":"2022-05-31T14:07:10.471Z","cooked":"\u003cp\u003eBro, YOU AREN’T LOSING GOLD. In the same time span of getting 3 gold and 30 food you are getting 3 gold and 45 food, and slightly faster at that. Why on earth do you think you are losing gold?\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T14:07:10.471Z","reply_count":3,"reply_to_post_number":5,"quote_count":0,"incoming_link_count":0,"reads":49,"readers_count":48,"score":24.8,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":"Age_Insider","flair_name":"Age_Insider","flair_url":"//cdn.ageofempires.com/aoe-forums/original/3X/5/7/57ac945b03e64b35defdd85916e382852840f723.png","flair_bg_color":"","flair_color":"","flair_group_id":56,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Age Insider","title_is_group":true,"reply_to_user":{"id":108960,"username":"StovetopHail455","avatar_template":"/user_avatar/forums.ageofempires.com/stovetophail455/{size}/29387_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":107195,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744356,"username":"SugaryGraph1416","avatar_template":"/user_avatar/forums.ageofempires.com/sugarygraph1416/{size}/29735_2.png","created_at":"2022-05-31T14:17:22.025Z","cooked":"\u003caside class=\"quote no-group\" data-username=\"StovetopHail455\" data-post=\"5\" data-topic=\"205270\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://forums.ageofempires.com/user_avatar/forums.ageofempires.com/stovetophail455/48/29387_2.png\" class=\"avatar\"\u003e StovetopHail455:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eyou have 1 less gold\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eto have 1 less gold IO should drop off in time.\u003cbr\u003e\nit’s more complicated.\u003c/p\u003e\n\u003cp\u003efrom 100 wood you get 10 gold\u003cbr\u003e\nafter wheelbarrow from 100 wood you will get 7(?)\u003cbr\u003e\nbut will IO collect all 10 gold in time?\u003cbr\u003e\nit’s all depends on number of villagers working\u003c/p\u003e\n\u003cp\u003eIt’s like to say, that English tech Enclosures - looses money until imperial, because it’s not researched.\u003c/p\u003e\n\u003cp\u003eCheck how many gold is in the end of the game, which never collected.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T14:17:22.025Z","reply_count":0,"reply_to_post_number":5,"quote_count":1,"incoming_link_count":2,"reads":48,"readers_count":47,"score":64.6,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":"Boston_Flight_Master","flair_name":"Phoenix_Closed_Beta","flair_url":"//cdn.ageofempires.com/aoe-forums/original/3X/1/8/180042a99e6acbe28d77ffcf154021f5d4e4bb5f.png","flair_bg_color":"","flair_color":"","flair_group_id":49,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"[Age Insider] Age II: DE Beta","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":49144,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/7","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744423,"username":"Shneider177","avatar_template":"/letter_avatar_proxy/v4/letter/s/b77776/{size}.png","created_at":"2022-05-31T16:06:25.550Z","cooked":"\u003cp\u003eYou not good at maFF my guy??\u003c/p\u003e\n\u003cp\u003estandard gather rates are 0.75 resources per sec (sheep, farm, wood, stone, gold); there is also IDLE times associated in gathering (walking, drop-off animation, return/initiate work animation).\u003c/p\u003e\n\u003cp\u003eFor simplicity we’ll just say gathering 10 food from sheep looks like this  10food / (13.33s + IDLE_time), this means without interruption you gather 1 tax per (13.33s + IDLE_time). If you research wheelbarrow which now makes you gather 5 more resources before you drop anything off?? it means your new gather rate looks like this 15 food / (20s + IDLE_time), which means your NEW tax generation rate is 1 tax per (20s +IDLE_time).\u003c/p\u003e\n\u003cp\u003e20s \u0026gt; 13.33s?\u003c/p\u003e\n\u003cp\u003eNow some other guy said “what about all the tax that is left on the table so to speak at the end of the game?” IMO that’s tax collection efficiency issue! One I hope they fix by introducing some form of auto-taxation via late game dynasty perk?? But the issue of wheelbarrow diminishing EARLY tax generation is meaningful when you’re MACRO depends on that generation.\u003c/p\u003e\n\u003cp\u003eAnother thing wheelbarrow is NOT 7-8% increase gather rate on all resources so to speak. It’s only 7-8% on resources that naturally force you to walk (lumber, farming, berries*). For resources you can gather virtually without walking the wheelbarrow increase is more so 2-3%. So again when you lose 33% taxation for ONLY a 3% gain resources? It’s a net LOSS for sheep, gold and stone total resources gathered.\u003c/p\u003e\n\u003cp\u003e(10 gathered resources + 1 tax ) / (13.33s + IDLE_time) compared to (15 gathered resources + 1 tax ) / (20s + IDLE_time). IDLE_time of the second ratio needs to go DOWN in order to be a faster rate than the first ratio. If there is no walking involved in the gathering process then IDLE_time CAN’T go down as a result of wheelbarrow.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T16:06:25.550Z","reply_count":0,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":0,"reads":43,"readers_count":42,"score":83.6,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":"Boston_Flight_Master","flair_name":"Age_Insider","flair_url":"//cdn.ageofempires.com/aoe-forums/original/3X/5/7/57ac945b03e64b35defdd85916e382852840f723.png","flair_bg_color":"","flair_color":"","flair_group_id":56,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Age Insider","title_is_group":false,"reply_to_user":{"id":107195,"username":"Calerb","avatar_template":"/user_avatar/forums.ageofempires.com/calerb/{size}/119454_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":5}],"moderator":false,"admin":false,"staff":false,"user_id":28142,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/8","reactions":[{"id":"heart","type":"emoji","count":5}],"current_user_reaction":null,"reaction_users_count":5,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":744428,"username":"StovetopHail455","avatar_template":"/user_avatar/forums.ageofempires.com/stovetophail455/{size}/29387_2.png","created_at":"2022-05-31T16:17:26.684Z","cooked":"\u003cp\u003e???\u003cbr\u003e\nYou are not getting 3 gold and 30 food in the same time you are getting 3 gold and 45 food…\u003c/p\u003e\n\u003cp\u003eThe gather rate is unchanged when you have researched wheelbarrow.\u003cbr\u003e\nIt takes 3x(10/0.75+2x1/(1.13))=45 seconds to gather 30 Food for example sheep 1 tile away from deposit, and 3x(15/0.75+2x1/(1.13x1.15))=64 seconds, to gather 45 Food with wheelbarrow.\u003c/p\u003e\n\u003cp\u003eSo you are getting 0.66 Food/s without wheelbarrow, and 0.70 with wheelbarrow(+6%).\u003cbr\u003e\nWhile you are getting 0.066 tax/s without wheebarrow, and 0.047 (-29%) tax/second with wheelbarrow.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":13,"updated_at":"2022-05-31T16:17:26.684Z","reply_count":0,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":0,"reads":42,"readers_count":41,"score":53.4,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":107195,"username":"Calerb","avatar_template":"/user_avatar/forums.ageofempires.com/calerb/{size}/119454_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":108960,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/9","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":745477,"username":"HighPingLord","avatar_template":"/user_avatar/forums.ageofempires.com/highpinglord/{size}/150342_2.png","created_at":"2022-06-02T16:01:06.110Z","cooked":"\u003cdiv class=\"youtube-onebox lazy-video-container\" data-video-id=\"E9BR-54FHPk\" data-video-title=\"The Chinese wheelbarrow paradox (AoE4)\" data-provider-name=\"youtube\"\u003e\n  \u003ca href=\"https://www.youtube.com/watch?v=E9BR-54FHPk\" target=\"_blank\" rel=\"noopener nofollow ugc\"\u003e\n    \u003cimg class=\"youtube-thumbnail\" src=\"https://forums.ageofempires.com/uploads/default/original/3X/6/8/680726f205cef9d63d26745e14a8d043f6e6cf6b.jpeg\" title=\"The Chinese wheelbarrow paradox (AoE4)\" data-dominant-color=\"858