til ALLLLLL factors kick in LATE that wheelbarrow becomes a comparative bonus to china vs other civs.\u003c/p\u003e\n\u003cp\u003eSo early using all his 1st to 3rd level analysis you had a 4 res/min+  per vil then a  1 tax/min - per vil then a 0.5 tax/min + per vil due to increase unit generation; So overall EARLY u looking at a 2.5 total res/min per vil.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":13,"updated_at":"2022-06-02T17:08:44.561Z","reply_count":0,"reply_to_post_number":10,"quote_count":0,"incoming_link_count":0,"reads":35,"readers_count":34,"score":22.0,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":"Boston_Flight_Master","flair_name":"Age_Insider","flair_url":"//cdn.ageofempires.com/aoe-forums/original/3X/5/7/57ac945b03e64b35defdd85916e382852840f723.png","flair_bg_color":"","flair_color":"","flair_group_id":56,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Age Insider","title_is_group":false,"reply_to_user":{"id":43959,"username":"HighPingLord","avatar_template":"/user_avatar/forums.ageofempires.com/highpinglord/{size}/150342_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":28142,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/11","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":834914,"username":"HeroChauvin9823","avatar_template":"/user_avatar/forums.ageofempires.com/herochauvin9823/{size}/143963_2.png","created_at":"2023-01-10T15:38:02.893Z","coo