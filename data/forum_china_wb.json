2 gold on his influence, so wheelbarrow in early is not a problem, nor it is in late game.\u003c/p\u003e","post_number":13,"post_type":1,"posts_count":13,"updated_at":"2023-01-11T14:57:52.203Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":2,"reads":16,"readers_count":15,"score":43.2,"yours":false,"topic_id":205270,"topic_slug":"china-taxes-and-wheelbarrow","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":110383,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/china-taxes-and-wheelbarrow/205270/13","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false}],"stream":[744221,744308,744324,744325,744345,744348,744356,744423,744428,745477,745503,834914,835192]},"timeline_lookup":[[1,1606],[8,1605],[10,1603],[12,1382],[13,1381]],"suggested_topics":[{"fancy_title":"Idea: What if English archers could build towers?","id":282162,"title":"Idea: What if English archers could build towers?","slug":"idea-what-if-english-archers-could-build-towers","posts_count":7,"reply_count":2,"highest_post_number":7,"image_url":null,"created_at":"2025-11-27T03:42:29.633Z","last_posted_at":"2025-11-28T17:00:24.225Z","bumped":true,"bumped_at":"2025-11-28T17:00:24.225Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"visible":true,"closed":false,"archived":false,"bookmarked":null,"l