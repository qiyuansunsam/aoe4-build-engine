{
  // Built by: python -X utf8 site/build.py --split-data --out deploy/cloudflare/dist
  "name": "mcaoe4",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "API_ORIGIN": "https://mcaoe4-api.fly.dev" }
  // Secret API_SECRET (same value as the Fly secret AOE_PROXY_SECRET): npx wrangler secret put API_SECRET
}
